{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "crystallize-mcp-server",
    // The Crystallize Cloudflare account. Pinned so a token or login that can see
    // several accounts never deploys to the wrong one. Not a secret.
    "account_id": "7341169551653f3f15b831f1c57e89e7",
    "main": "src/index.ts",
    "routes": [
        {
            "pattern": "mcp.crystallize.com",
            "custom_domain": true,
        },
    ],
    "compatibility_date": "2025-08-03",
    "compatibility_flags": ["nodejs_compat"],
    "placement": {
        "mode": "smart",
    },
    // Workers AI, for TypeSafe's Jev model (typesafe/jev): picks Core schema domains for an intent.
    "ai": {
        "binding": "AI",
    },
    "vars": {
        // Plausible site ID for the SERVER-side MCP events. The Events API needs
        // no key — the site is identified by this alone, so it is a plain var, not
        // a secret. Unset it to disable MCP tracking.
        "PLAUSIBLE_DOMAIN": "mcp.crystallize.com",
        // The landing page's tracking script, from Site Settings → Site installation.
        // The v2 script compiles the domain into this filename, so there is no
        // data-domain attribute. Unset it to drop the script from the page.
        // Public by nature — it ships in the page's HTML. Not a secret.
        "PLAUSIBLE_SCRIPT_URL": "https://plausible.io/js/pa-VtwNguh3SIy5jYVmDZF5N.js",
        // Override to point at a self-hosted Plausible or a first-party proxy.
        "PLAUSIBLE_API_ENDPOINT": "https://plausible.io/api/event",
    },
    // Off on purpose: no Worker logs or traces are kept. Leave `logs.enabled` false too — a deploy applies this file
    // and would otherwise switch persisted logs back on, whatever the dashboard says.
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
}
