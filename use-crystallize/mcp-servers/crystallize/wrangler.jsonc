{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The top level is the DEV worker: what `bun dev` runs locally and what `deploy-mcp-dev.yaml` ships on every push
    // to `main` (`bun run deploy:dev`), reached through the API gateway proxy at its workers.dev URL.
    // Production is `env.production` below, selected at BUILD time with CLOUDFLARE_ENV=production (`bun run deploy`):
    // the Vite plugin flattens that block into the generated config, so forgetting it lands on dev, never production.
    "name": "crystallize-mcp-server-dev",
    // The Crystallize Cloudflare account. Pinned so a token or login that can see
    // several accounts never deploys to the wrong one. Not a secret.
    "account_id": "7341169551653f3f15b831f1c57e89e7",
    "main": "src/index.ts",
    // No routes: the dev worker only answers on workers.dev. Routes and workers_dev are INHERITED by an env, so
    // `env.production` sets both explicitly.
    "workers_dev": true,
    "compatibility_date": "2025-08-03",
    "compatibility_flags": ["nodejs_compat"],
    "placement": {
        "mode": "smart",
    },
    // Workers AI, for TypeSafe's Jev model (typesafe/jev): picks Core schema domains for an intent.
    // Bindings are NOT inherited: repeated in `env.production`.
    "ai": {
        "binding": "AI",
    },
    // Vars are NOT inherited either. No PLAUSIBLE_* here: dev and local traffic never report into the production site.
    "vars": {
        // Requests without an X-Crystallize-Environment header go to dev; `production` still switches them back.
        // Needs the CRYSTALLIZE_DEV_API_ORIGIN secret (on the dev worker, or in `.env` locally), or every header-less
        // request is a 500.
        "CRYSTALLIZE_DEFAULT_ENVIRONMENT": "dev",
    },
    // Off on purpose: no Worker logs or traces are kept. Leave `logs.enabled` false too — a deploy applies this file
    // and would otherwise switch persisted logs back on, whatever the dashboard says. Inherited by `env.production`.
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": false,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
    "env": {
        "production": {
            "name": "crystallize-mcp-server",
            "routes": [
                {
                    "pattern": "mcp.crystallize.com",
                    "custom_domain": true,
                },
            ],
            // Explicit, or it would inherit the dev worker's `true` and expose production on workers.dev.
            "workers_dev": false,
            "ai": {
                "binding": "AI",
            },
            "vars": {
                // Same as leaving it unset; spelled out so production's choice is visible here.
                "CRYSTALLIZE_DEFAULT_ENVIRONMENT": "production",
                // Plausible site ID for the SERVER-side MCP events. The Events API needs
                // no key — the site is identified by this alone, so it is a plain var, not
                // a secret. Unset it to disable MCP tracking.
                "PLAUSIBLE_DOMAIN": "mcp.crystallize.com",
                // The landing page's tracking script, from Site Settings → Site installation.
                // The v2 script compiles the domain into this filename, so there is no
                // data-domain attribute. Unset it to drop the script from the page.
                // Public by nature — it ships in the page's HTML. Not a secret.
                "PLAUSIBLE_SCRIPT_URL": "https://plausible.io/js/pa-VtwNguh3SIy5jYVmDZF5N.js",
                // Override to point at a self-hosted Plausible or a first-party proxy.
                "PLAUSIBLE_API_ENDPOINT": "https://plausible.io/api/event",
            },
        },
    },
}
